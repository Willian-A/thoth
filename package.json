{
  "name": "thoth",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome ci . && pnpm depcruise",
    "format": "biome check --write .",
    "depcruise": "depcruise apps packages",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @thoth/web test:e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
